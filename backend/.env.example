# VerifAI Backend — copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# CORS: comma-separated origins. For Flutter mobile, this can normally be empty.
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin: use either a local JSON file OR the JSON string on Railway.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional production hardening
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
