# VerifAI Backend — copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
# Supabase Postgres. Get this from Project Settings -> Database -> Connection
# string. Use the session pooler (port 5432) so long-lived Node connections are
# supported; the transaction pooler (6543) also works but needs `pgbouncer=true`.
# Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# CORS: comma-separated origins. For Flutter mobile, this can normally be empty.
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin: use either a local JSON file OR the JSON string on Railway.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# NVIDIA hosted inference (NVIDIA API Catalog). Keep the API key server-side.
NVIDIA_API_KEY=
# Per-use-case model routing. The reasoning model serves both analysis and the
# conversational surfaces (assistant, coach, Vera); a retryable failure falls
# back to NVIDIA_MODEL_FALLBACK. Override NVIDIA_MODEL_CHAT to lighten cost.
NVIDIA_MODEL_ANALYSIS=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_FALLBACK=openai/gpt-oss-20b
# Legacy single-model override (still honoured as the fallback base).
NVIDIA_MODEL=openai/gpt-oss-20b

# Reward token economy: spendable tokens earned from milestones (XP is never
# spent). One grant per level gained, plus a bonus per achievement earned.
TOKENS_PER_LEVEL=10
TOKENS_PER_ACHIEVEMENT=5

# Tavily web search — used by the Verification Studio and by Vera when a learner
# asks her to verify something. Optional: without it, verification works from
# the submitted material alone and Vera answers without live sources.
TAVILY_API_KEY=

# Global API rate limit. Counted per signed-in account (the bearer token's uid),
# falling back to the client IP for unauthenticated routes. Health checks are
# exempt. Task/progress traffic is the point of the app, so this is a loose
# backstop; /api/assistant has its own much stricter per-user limit.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Streak day-boundary timezone (IANA name). Defaults to Africa/Johannesburg;
# change only if your users' local days should anchor elsewhere.
STREAK_TIMEZONE=Africa/Johannesburg

# Admin dashboard: comma-separated emails allowed to use /api/admin and /admin.
ADMIN_EMAILS=admin@example.com
