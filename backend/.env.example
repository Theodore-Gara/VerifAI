# VerifAI Backend — copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
# Supabase Postgres. Get this from Project Settings -> Database -> Connection
# string. Use the session pooler (port 5432) so long-lived Node connections are
# supported; the transaction pooler (6543) also works but needs `pgbouncer=true`.
# Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# CORS: comma-separated origins. For Flutter mobile, this can normally be empty.
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin: use either a local JSON file OR the JSON string on Railway.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# NVIDIA hosted inference (NVIDIA API Catalog). Keep the API key server-side.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Optional production hardening
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
